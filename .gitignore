.env
.env.txt
*.log
*_log.txt
__pycache__/
# pollster PDFs (~4 MB each); links in the manifest, checksums in data/supplement/polls_supplement.json
data/raw/atlasintel/**/*.pdf
# per-state Wikipedia result pages (~150 MB per snapshot); the parsed data/scorecard/margins_*.csv keep each page's revision id
data/raw/wikipedia_results_pages/
# per-race Wikipedia pages as of the final forecast's VoteHub snapshot (poll audit); revision ids are kept in data/scorecard/wiki_polls_*.csv
data/raw/wikipedia_polls_asof/
# project environment lives outside OneDrive (README "Environment"); this catches an accidental uv sync without UV_PROJECT_ENVIRONMENT
.venv/
# store-and-link sources (DATA.md "Linked sources"): raw copies stay local; the manifest of fetches is committed
data/linked/*/
# Jennings-Wlezien replication file (290 MB, 45 countries); the US presidential extract beside it is committed
data/raw/jennings_wlezien/**/LONG_MI_NATURE_20180111.tab
# Gary Jacobson's House elections file, sent by email with leave to use and cite, not to redistribute (DATA.md "Linked sources")
data/raw/jacobson/
# local and CI run output (scorecard, specials watch)
ci_out/
# exported tracker state (statuses, private notes, provisional numbers) from the hosted workplan page
planning/*.local.json
